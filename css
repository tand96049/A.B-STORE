/* ================================
   A.B STORE — MAIN STYLESHEET
   ================================ */

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: Arial, Helvetica, sans-serif;
  background: #09090b;
  color: #f5f5f5;
  line-height: 1.6;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
select,
textarea {
  font: inherit;
}

.container {
  width: min(1180px, 92%);
  margin: 0 auto;
}

/* ================================
   HEADER
   ================================ */

.header {
  position: sticky;
  top: 0;
  z-index: 1000;
  background: rgba(9, 9, 11, 0.92);
  backdrop-filter: blur(18px);
  border-bottom: 1px solid #27272a;
}

.nav {
  min-height: 76px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}

.logo {
  font-size: 24px;
  font-weight: 900;
  letter-spacing: -1px;
  color: #ffffff;
}

.logo span {
  color: #a78bfa;
}

.menu {
  display: flex;
  align-items: center;
  gap: 28px;
}

.menu a {
  color: #d4d4d8;
  font-size: 15px;
  font-weight: 600;
  transition: 0.25s ease;
}

.menu a:hover {
  color: #a78bfa;
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.cart-btn {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 9px 13px;
  border: 1px solid #3f3f46;
  border-radius: 12px;
  background: #18181b;
  color: #ffffff;
  font-size: 14px;
  font-weight: 700;
  transition: 0.25s ease;
}

.cart-btn:hover {
  border-color: #a78bfa;
  transform: translateY(-2px);
}

.cart-btn span {
  min-width: 22px;
  padding: 2px 6px;
  border-radius: 50px;
  background: #a78bfa;
  color: #111827;
  text-align: center;
  font-size: 12px;
}

/* ================================
   BURGER
   ================================ */

.burger {
  display: none;
  width: 42px;
  height: 42px;
  padding: 7px;
  border: 1px solid #3f3f46;
  border-radius: 11px;
  background: #18181b;
  cursor: pointer;
}

.burger span {
  display: block;
  width: 23px;
  height: 2px;
  margin: 5px auto;
  border-radius: 5px;
  background: #ffffff;
  transition: 0.3s ease;
}

.burger:hover {
  border-color: #a78bfa;
}

/* ================================
   MOBILE MENU
   ================================ */

.mobile-menu {
  display: none;
  max-height: 0;
  overflow: hidden;
  background: #0c0c0f;
  border-top: 1px solid transparent;
  transition: max-height 0.35s ease;
}

.mobile-menu.open {
  max-height: 600px;
  border-top-color: #27272a;
}

.mobile-menu a {
  display: block;
  margin: 4px 4%;
  padding: 13px 15px;
  border-radius: 10px;
  color: #ffffff;
  font-weight: 600;
  transition: 0.2s ease;
}

.mobile-menu a:hover {
  background: #18181b;
  color: #a78bfa;
}

/* ================================
   HERO
   ================================ */

.hero {
  padding: 105px 0 90px;
  background:
    radial-gradient(
      circle at 80% 20%,
      rgba(49, 46, 129, 0.65),
      transparent 35%
    ),
    radial-gradient(
      circle at 15% 55%,
      rgba(22, 78, 99, 0.45),
      transparent 30%
    );
}

.hero-content {
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  align-items: center;
  gap: 65px;
}

.eyebrow {
  margin-bottom: 12px;
  color: #a78bfa;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 2px;
}

.hero h1 {
  font-size: clamp(44px, 7vw, 78px);
  line-height: 1.02;
  letter-spacing: -4px;
}

.hero h1 span {
  color: #a78bfa;
}

.hero-description {
  max-width: 610px;
  margin: 25px 0;
  color: #a1a1aa;
  font-size: 18px;
}

.hero-buttons {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}

/* ================================
   BUTTONS
   ================================ */

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12px 21px;
  border-radius: 12px;
  font-weight: 800;
  transition: 0.25s ease;
}

.btn:hover {
  transform: translateY(-3px);
}

.btn.primary {
  background: #a78bfa;
  color: #111827;
}

.btn.primary:hover {
  box-shadow: 0 12px 30px rgba(167, 139, 250, 0.25);
}

.btn.secondary {
  border: 1px solid #52525b;
  background: #18181b;
  color: #ffffff;
}

.btn.secondary:hover {
  border-color: #a78bfa;
}

/* ================================
   HERO CARD
   ================================ */

.hero-card {
  min-height: 320px;
  display: grid;
  place-items: center;
  border: 1px solid #3f3f46;
  border-radius: 28px;
  background: linear-gradient(145deg, #18181b, #111827);
  box-shadow: 0 30px 80px rgba(0, 0, 0, 0.35);
  animation: floatingCard 4s ease-in-out infinite;
}

.hero-card-inner {
  text-align: center;
}

.hero-card-inner > span {
  display: block;
  margin-bottom: 10px;
  font-size: 72px;
}

.hero-card h3 {
  font-size: 30px;
}

.hero-card p {
  margin-top: 6px;
  color: #a1a1aa;
}

@keyframes floatingCard {
  0%,
  100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-10px);
  }
}

/* ================================
   SECTIONS
   ================================ */

.categories,
.featured,
.why-us,
.offer {
  padding: 85px 0;
}

.section-heading {
  margin-bottom: 40px;
  text-align: center;
}

.section-heading h2 {
  font-size: 38px;
  line-height: 1.2;
  letter-spacing: -1px;
}

.section-heading > p:not(.eyebrow) {
  margin-top: 8px;
  color: #a1a1aa;
}

/* ================================
   CATEGORY CARDS
   ================================ */

.category-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
}

.category-card {
  padding: 28px;
  border: 1px solid #27272a;
  border-radius: 20px;
  background: #111113;
  transition: 0.3s ease;
}

.category-card:hover {
  transform: translateY(-6px);
  border-color: #52525b;
  background: #151518;
}

.category-card > span {
  display: block;
  margin-bottom: 8px;
  font-size: 36px;
}

.category-card h3 {
  font-size: 19px;
}

.category-card p {
  margin-top: 5px;
  color: #a1a1aa;
  font-size: 14px;
}

/* ================================
   PRODUCT GRID
   ================================ */

.product-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
}

.product-placeholder {
  grid-column: 1 / -1;
  padding: 60px 25px;
  border: 1px dashed #3f3f46;
  border-radius: 20px;
  text-align: center;
  background: #0d0d10;
}

.placeholder-icon {
  margin-bottom: 10px;
  font-size: 50px;
}

.product-placeholder h3 {
  font-size: 22px;
  margin-bottom: 8px;
}

.product-placeholder p {
  max-width: 600px;
  margin: 0 auto 20px;
  color: #a1a1aa;
}

/* ================================
   FEATURES
   ================================ */

.features-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
}

.feature-card {
  padding: 28px;
  border: 1px solid #27272a;
  border-radius: 20px;
  background: #111113;
  transition: 0.3s ease;
}

.feature-card:hover {
  transform: translateY(-6px);
  border-color: #52525b;
}

.feature-card > span {
  display: block;
  margin-bottom: 8px;
  font-size: 35px;
}

.feature-card h3 {
  font-size: 18px;
}

.feature-card p {
  margin-top: 6px;
  color: #a1a1aa;
  font-size: 14px;
}

/* ================================
   OFFER
   ================================ */

.offer-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
  padding: 42px;
  border: 1px solid #3f3f46;
  border-radius: 25px;
  background: linear-gradient(110deg, #18181b, #111827);
}

.offer-box h2 {
  font-size: 38px;
  line-height: 1.2;
}

.offer-box h2 span {
  color: #a78bfa;
}

.offer-box p:not(.eyebrow) {
  margin-top: 8px;
  color: #a1a1aa;
}

/* ================================
   FOOTER
   ================================ */

.footer {
  padding-top: 60px;
  border-top: 1px solid #27272a;
  background: #070709;
}

.footer-grid {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr;
  gap: 45px;
  padding-bottom: 50px;
}

.footer-brand p {
  margin-top: 12px;
  color: #a1a1aa;
}

.footer-links {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.footer-links h3 {
  margin-bottom: 8px;
  font-size: 16px;
}

.footer-links a {
  color: #a1a1aa;
  font-size: 14px;
  transition: 0.2s ease;
}

.footer-links a:hover {
  color: #a78bfa;
}

.footer-bottom {
  padding: 20px;
  border-top: 1px solid #27272a;
  text-align: center;
  color: #71717a;
  font-size: 13px;
}

/* ================================
   TABLET
   ================================ */

@media (max-width: 900px) {
  .menu {
    gap: 16px;
  }

  .menu a {
    font-size: 14px;
  }

  .hero-content {
    grid-template-columns: 1fr;
  }

  .hero-card {
    min-height: 250px;
  }

  .category-grid,
  .features-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .product-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

/* ================================
   MOBILE
   ================================ */

@media (max-width: 700px) {
  .nav {
    min-height: 68px;
  }

  .menu {
    display: none;
  }

  .burger {
    display: block;
  }

  .mobile-menu {
    display: block;
  }

  .hero {
    padding: 70px 0;
  }

  .hero h1 {
    font-size: 46px;
    letter-spacing: -2px;
  }

  .hero-description {
    font-size: 16px;
  }

  .hero-card {
    min-height: 220px;
  }

  .section-heading h2 {
    font-size: 31px;
  }

  .categories,
  .featured,
  .why-us,
  .offer {
    padding: 65px 0;
  }

  .offer-box {
    flex-direction: column;
    align-items: flex-start;
    padding: 30px;
  }

  .offer-box h2 {
    font-size: 31px;
  }

  .footer-grid {
    grid-template-columns: 1fr 1fr;
  }
}

/* ================================
   SMALL MOBILE
   ================================ */

@media (max-width: 480px) {
  .container {
    width: 90%;
  }

  .logo {
    font-size: 21px;
  }

  .cart-btn {
    padding: 8px 9px;
    font-size: 13px;
  }

  .burger {
    width: 40px;
    height: 40px;
  }

  .hero h1 {
    font-size: 40px;
  }

  .hero-buttons {
    width: 100%;
  }

  .hero-buttons .btn {
    flex: 1;
  }

  .category-grid,
  .features-grid,
  .product-grid {
    grid-template-columns: 1fr;
  }

  .footer-grid {
    grid-template-columns: 1fr;
    gap: 30px;
  }

  .offer-box {
    padding: 25px;
  }
  }
